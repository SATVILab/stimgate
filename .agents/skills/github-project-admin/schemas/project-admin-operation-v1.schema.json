{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MiguelRodo/projects/skills/github-project-admin/schemas/project-admin-operation-v1.schema.json",
  "title": "GitHub Project administration operation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "issue", "operations"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "ownerType", "number"],
      "properties": {
        "owner": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "ownerType": { "enum": ["user", "organization"] },
        "number": { "type": "integer", "minimum": 1 }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "number": { "type": "integer", "minimum": 1 },
        "expectedUpdatedAt": { "type": ["string", "null"] }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": { "kind": { "const": "ensure_project_membership" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "field", "value"],
            "properties": {
              "kind": { "const": "set_single_select" },
              "field": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 },
              "expected": { "type": ["string", "null"] }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "field", "value"],
            "properties": {
              "kind": { "const": "set_date" },
              "field": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "expected": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "field"],
            "properties": {
              "kind": { "const": "clear_field" },
              "field": { "type": "string", "minLength": 1 },
              "expected": { "type": ["string", "null"] }
            }
          }
        ]
      }
    }
  }
}
